# meowhub — environment inventory
#
# Every variable this deployment needs, named here with no value (ADR 0010,
# ADR 0034). Deployment settings live here; household settings live in the
# database (accounts, categories, members, budgets) and are never added here.
#
# A required variable missing at startup must make its component fail loudly,
# never fall back to a default hidden in code.

# ── Identity of this deployment ─────────────────────────────────────────────
# local | deployed
MEOWHUB_ENV=
# Must match this checkout's own directory name — Docker Compose infers its
# project name from that basename by default, and the scheduler container
# (spec 0001 T16) needs to be told explicitly since it sees its own
# bind-mounted path (/workspace), not the host's real directory name.
COMPOSE_PROJECT_NAME=
# stable across the move home — passkeys bind to it (ADR 0006/0032)
PUBLIC_HOSTNAME=

# ── Ingress (ADR 0002, spec 0001 T11) ───────────────────────────────────────
# One reverse proxy, one hostname. PUBLIC_HOSTNAME above decides TLS: a name
# that isn't a public domain (e.g. localhost) gets an automatic, locally
# trusted certificate; a real domain gets ACME. No other component's port is
# published to the host in any environment — this is the only way in.
# host port -> the proxy's 80 (ACME challenges only; irrelevant on localhost)
PROXY_HTTP_PORT=
# host port -> the proxy's 443
PROXY_HTTPS_PORT=

# ── PostgreSQL (ADR 0004, 0018) ─────────────────────────────────────────────
POSTGRES_HOST=
POSTGRES_PORT=
POSTGRES_DB=
POSTGRES_SUPERUSER=
POSTGRES_SUPERUSER_PASSWORD=
# dbmate target, e.g. postgres://user:pass@host:port/db?sslmode=disable
DATABASE_URL=

# Only authenticator ever logs in directly (spec 0002 R15b): PostgREST
# connects as it and switches into the role a verified JWT names via SET
# ROLE, the standard PostgREST pattern. The other five roles (anon,
# hh_member, hh_admin, hh_agent, hh_report) are NOLOGIN and need no password.
DB_ROLE_AUTHENTICATOR_PASSWORD=
# PostgREST JWT secret (ADR 0014)
PGRST_JWT_SECRET=

# ── n8n (ADR 0001) ───────────────────────────────────────────────────────────
# losing this loses every credential n8n stores — two custodians, ADR 0024
N8N_ENCRYPTION_KEY=
N8N_HOST=
N8N_PORT=
# n8n's own inner login, behind the boundary (spec 0002 R17a)
N8N_BASIC_AUTH_ACTIVE=
N8N_BASIC_AUTH_USER=
N8N_BASIC_AUTH_PASSWORD=
# N8N_BLOCK_ENV_ACCESS_IN_NODE is fixed to false in compose.yaml, not a per-deployment
# variable: this instance is single-tenant and behind our own auth boundary, so
# workflows reading $env by design (ADR 0034) is a deployment choice, not exposure
# to untrusted workflow authors.

# ── Telegram (ADR 0027, ADR 0033) ───────────────────────────────────────────
# the household's bot — deployed mode only
TELEGRAM_BOT_TOKEN=
# a SEPARATE registration for local polling — never the household's token
TELEGRAM_LOCAL_BOT_TOKEN=
# webhook | polling — one variable switches the whole mode
TELEGRAM_DELIVERY_MODE=
# TELEGRAM_ADMIN_CHAT_ID is interim (spec 0001 T15): one admin's chat id for
# infrastructure reports (a failed restore verification) that must reach a
# human directly. Spec 0002 replaces this with every admin's real identity.
TELEGRAM_ADMIN_CHAT_ID=
# TELEGRAM_API_BASE_URL replaces the whole reporting endpoint when set — how
# tests stub scripts/telegram-report.sh offline (ADR 0015). Leave unset in
# any real deployment.

# ── Model gateway (ADR 0029, spec 0001 T18) ─────────────────────────────────
OPENROUTER_API_KEY=
# The local stub (model-gateway/docker) is what local dev and tests point
# at by default, so nothing here costs money or needs a real key until a
# developer deliberately points OPENROUTER_BASE_URL at the real gateway.
# From inside n8n: http://model-gateway-stub:8090 — the compose service
# name, not the host loopback port.
OPENROUTER_BASE_URL=
# host loopback port -> the stub's 8090, for scripts run from the host
MODEL_GATEWAY_STUB_PORT=
MODEL_TEXT_EXTRACTION=
MODEL_QUERY_MAPPING=
MODEL_RECEIPT_VISION=
MODEL_VOICE=
MODEL_STATEMENT_PDF=
MODEL_SPEND_CEILING_DAILY_EUR=

# ── Identity provider (ADR 0006/0032) ───────────────────────────────────────
AUTHENTIK_SECRET_KEY=
AUTHENTIK_BOOTSTRAP_EMAIL=
AUTHENTIK_BOOTSTRAP_PASSWORD=
# The proxy's own address (spec 0002 T9) — the household app has none yet,
# so this guards the /rest path in its place. Same host/port as
# PUBLIC_HOSTNAME/PROXY_HTTPS_PORT above, spelled as a full URL because
# that is the shape Authentik's Proxy Provider needs.
AUTHENTIK_APP_EXTERNAL_HOST=
# Generated by scripts/configure-token-bridge.sh on first `task up` — the
# token bridge's own service account (spec 0002 T10) queries Authentik's
# API for a member's group membership directly, rather than trusting the
# forward-auth response's X-Authentik-Groups header, which turned out to
# depend on which OAuth scopes a given request happened to negotiate.
AUTHENTIK_API_TOKEN=
# optional — only if Sign in with Apple is added
APPLE_SERVICES_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=

# ── First admin scaffold (spec 0001 R14d/e, spec 0002) ──────────────────────
SCAFFOLD_ADMIN_EMAIL=
# marked initial; must be changed at first sign-in
SCAFFOLD_ADMIN_PASSWORD=

# ── Backups (ADR 0009, ADR 0024) ────────────────────────────────────────────
# local path in dev; EU offsite URL when deployed
RESTIC_REPOSITORY=
# sealed paper copy exists outside any computer — two custodians
RESTIC_PASSWORD=
# Hetzner Storage Box / Scaleway / OVHcloud — EU only (ADR 0028)
BACKUP_OFFSITE_REPOSITORY=
BACKUP_OFFSITE_ACCESS_KEY=
BACKUP_OFFSITE_SECRET_KEY=

# ── Monitoring (ADR 0020, spec 0001 T13) ────────────────────────────────────
# Kuma is admin-only tooling, not a household-facing surface (R6 is trivially
# true for it: there is nothing to put behind the boundary because it is
# never public) — bound to loopback only, reached by an SSH tunnel once
# deployed, same as on the laptop.
# host loopback port -> Kuma's 3001
UPTIME_KUMA_PORT=
# e.g. http://127.0.0.1:3001 — where scripts/configure-monitoring.sh and scripts/*.sh reach it
UPTIME_KUMA_URL=
# created by scripts/configure-monitoring.sh on first run
UPTIME_KUMA_ADMIN_USERNAME=
UPTIME_KUMA_ADMIN_PASSWORD=
# Each push URL's token is minted by Kuma, not chosen by a developer:
# scripts/configure-monitoring.sh creates the monitor on first run and
# writes the resulting URL back into .env itself. Leave these blank in a
# fresh checkout.
HEARTBEAT_BACKUP_URL=
HEARTBEAT_RESTORE_VERIFY_URL=
# window: docs/standards/budgets.md
HEARTBEAT_DRIFT_CHECK_URL=

# ── File storage (ADR 0019) ─────────────────────────────────────────────────
# a dedicated volume; content-addressed by SHA-256
FILE_STORAGE_PATH=
