    {
      "id": "en-no-amount",
      "text": "that was expensive",
      "context": { "currency": "EUR", "today": "2026-09-13", "known_merchant_aliases": {}, "merchant_default_category": {}, "known_categories": [], "known_accounts": ["ABN AMRO Current"] },
      "expect": { "status": "question" }
    },
    {
      "id": "en-invented-account",
