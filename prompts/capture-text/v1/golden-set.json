{
  "prompt": "capture-text",
  "version": "capture-text@1",
  "description": "Spec 0003 T15 / ADR 0025: cases run against a real model before and after any change to this prompt, in both languages, covering the same scenarios this slice's own acceptance criteria name. Wording differences do not fail a case; a wrong amount, merchant, category or payment account does.",
  "cases": [
    {
      "id": "en-bare-amount",
      "text": "coffee 350",
      "context": { "currency": "EUR", "today": "2026-09-13", "known_merchant_aliases": {}, "merchant_default_category": {}, "known_categories": ["dining"], "known_accounts": ["ABN AMRO Current"] },
      "expect": { "status": "resolved", "amount_minor": 350, "currency": "EUR" }
    },
    {
      "id": "ru-bare-amount",
      "text": "кофе 350",
      "context": { "currency": "EUR", "today": "2026-09-13", "known_merchant_aliases": {}, "merchant_default_category": {}, "known_categories": ["dining"], "known_accounts": ["ABN AMRO Current"] },
      "expect": { "status": "resolved", "amount_minor": 350, "currency": "EUR" }
    },
    {
      "id": "en-decimal-comma",
      "text": "groceries 24,40 albert heijn",
      "context": { "currency": "EUR", "today": "2026-09-13", "known_merchant_aliases": { "albert heijn": "Albert Heijn" }, "merchant_default_category": { "Albert Heijn": "groceries" }, "known_categories": ["groceries"], "known_accounts": ["ABN AMRO Current"] },
      "expect": { "status": "resolved", "amount_minor": 2440, "merchant": "Albert Heijn", "category_slug": "groceries" }
    },
    {
