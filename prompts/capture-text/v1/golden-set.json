    {
      "id": "en-alias-spelling-variant",
      "text": "quick shop 1200 AH",
      "context": { "currency": "EUR", "today": "2026-09-13", "known_merchant_aliases": { "ah": "Albert Heijn", "albert heijn": "Albert Heijn" }, "merchant_default_category": { "Albert Heijn": "groceries" }, "known_categories": ["groceries"], "known_accounts": ["ABN AMRO Current"] },
      "expect": { "status": "resolved", "amount_minor": 1200, "merchant": "Albert Heijn", "category_slug": "groceries" }
