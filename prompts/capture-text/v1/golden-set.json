    {
      "id": "en-unseen-merchant",
      "text": "lunch 800 at Green Leaf Diner",
      "context": { "currency": "EUR", "today": "2026-09-13", "known_merchant_aliases": { "ah": "Albert Heijn", "albert heijn": "Albert Heijn" }, "merchant_default_category": { "Albert Heijn": "groceries" }, "known_categories": ["groceries", "dining"], "known_accounts": ["ABN AMRO Current"] },
      "expect": { "status": "resolved", "amount_minor": 800, "merchant": "Green Leaf Diner" }
