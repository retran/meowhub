{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "setup-conversation output",
  "type": "object",
  "additionalProperties": false,
  "required": ["status"],
  "properties": {
    "status": { "type": "string", "enum": ["resolved", "question"] },
    "done": { "type": ["boolean", "null"] },
    "account_name": { "type": ["string", "null"] },
    "account_type": { "type": ["string", "null"], "enum": ["asset", "liability", null] },
    "opening_balance_minor": { "type": ["integer", "null"] },
    "overdraft_limit_minor": { "type": ["integer", "null"] },
    "credit_limit_minor": { "type": ["integer", "null"] },
    "timezone": { "type": ["string", "null"] },
    "currency": { "type": ["string", "null"] },
    "question": { "type": ["string", "null"] }
  }
}
