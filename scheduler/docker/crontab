# Drift detection, once daily (spec 0001 T16, R13). Runs inside /workspace,
# the repository bind-mounted read-only, using the same scripts and
# Taskfile verbs a developer would from the host.
0 3 * * * cd /workspace && bash scripts/detect-drift.sh >> /proc/1/fd/1 2>> /proc/1/fd/2

# Auto-confirm-quiet (spec 0003 T12, R7c), every 15 minutes — cheap
# enough that the quiet period is what actually paces it, not the cron
# schedule.
*/15 * * * * cd /workspace && bash scripts/auto-confirm-quiet.sh >> /proc/1/fd/1 2>> /proc/1/fd/2

# The digest tick (spec 0004 T11, R9/R10/R17), hourly. The hour is not
# the schedule: SQL decides who is due at Monday 09:00 and on the 1st in
# the household's own timezone, and a tick that finds nobody does
# nothing. Hourly is only how often the question gets asked, which is
# what makes a missed hour heal itself.
0 * * * * cd /workspace && bash scripts/digest-tick.sh >> /proc/1/fd/1 2>> /proc/1/fd/2
