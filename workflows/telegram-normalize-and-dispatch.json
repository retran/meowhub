    {
      "id": "d0000000-0000-4000-8000-000000000007",
      "name": "Mint Agent Token",
      "parameters": {
        "jsCode": "// A member is ours (ADR 0030); resolving a sender to one is a data-API\n// read like any other (ADR 0014), so this mints the same short-lived,\n// stateless HS256 token the token bridge mints for a browser session\n// (ADR 0041) rather than holding a standing database credential (R16).\nconst crypto = require('crypto');\nconst b64url = (buf) => buf.toString('base64').replace(/\\+/g, '-').replace(/\\//g, '_').replace(/=+$/, '');\nconst header = b64url(Buffer.from(JSON.stringify({ alg: 'HS256', typ: 'JWT' })));\nconst payload = b64url(Buffer.from(JSON.stringify({ role: 'hh_agent', exp: Math.floor(Date.now() / 1000) + 60 })));\nconst signingInput = `${header}.${payload}`;\nconst signature = b64url(crypto.createHmac('sha256', $env.PGRST_JWT_SECRET).update(signingInput).digest());\nreturn [{ json: { ...$json, agent_token: `${signingInput}.${signature}` } }];"
      },
      "position": [
        1040,
        100
      ],
      "type": "n8n-nodes-base.code",
      "typeVersion": 2
    },
