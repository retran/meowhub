    {
      "id": "d0000000-0000-4000-8000-00000000000b",
      "name": "Reply Denied",
      "parameters": {
        "jsonBody": "={{ { chat_id: $('Mint Agent Token').item.json.chat_id, ...($('Mint Agent Token').item.json.message_thread_id ? { message_thread_id: $('Mint Agent Token').item.json.message_thread_id } : {}), text: ($('Mint Agent Token').item.json.language_hint === \"ru\" ? \"\u042f \u0432\u0430\u0441 \u043f\u043e\u043a\u0430 \u043d\u0435 \u0437\u043d\u0430\u044e. \u041f\u043e\u043f\u0440\u043e\u0441\u0438\u0442\u0435 \u0430\u0434\u043c\u0438\u043d\u0438\u0441\u0442\u0440\u0430\u0442\u043e\u0440\u0430 \u043f\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u0438\u0442\u044c \u043c\u0435\u043d\u044f \u0432\u0430\u043c.\" : \"I do not yet know you. Ask an admin to introduce us.\") } }}",
        "method": "POST",
        "options": {},
        "sendBody": true,
        "specifyBody": "json",
        "url": "=https://api.telegram.org/bot{{ $('Mint Agent Token').item.json.source === 'polling' || $env.TELEGRAM_DELIVERY_MODE === 'polling' ? $env.TELEGRAM_LOCAL_BOT_TOKEN : $env.TELEGRAM_BOT_TOKEN }}/sendMessage"
