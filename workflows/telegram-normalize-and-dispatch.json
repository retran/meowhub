      "parameters": {
        "jsCode": "const m = $('Mint Agent Token').item.json;\nconst text = m.language_hint === 'ru'\n  ? 'Meow \u043d\u0430 \u0441\u0432\u044f\u0437\u0438. \u0418\u043d\u0444\u0440\u0430\u0441\u0442\u0440\u0443\u043a\u0442\u0443\u0440\u0430 \u0441\u043e\u0431\u0440\u0430\u043d\u0430, \u043f\u0440\u043e\u0434\u0443\u043a\u0442 \u0435\u0449\u0451 \u0432\u043f\u0435\u0440\u0435\u0434\u0438.'\n  : 'Meow is here. The infrastructure works; the product comes next.';\nreturn [{ json: { chat_id: m.chat_id, message_thread_id: m.message_thread_id, text } }];"
