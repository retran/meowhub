    {
      "id": "d0000000-0000-4000-8000-00000000000c",
      "name": "Route Message",
      "parameters": {
        "jsCode": "// Normalise a linked sender's message into what the agent needs\n// (ADR 0046). There is no routing left to do: one conversational\n// entry point, one agent, and the agent decides what the message is.\n// A photo or voice note is still out of this slice's scope (spec 0005).\nconst m = $('Mint Agent Token').item.json;\nconst memberId = $json.body[0].member_id;\nconst base = {\n  member_id: memberId,\n  chat_id: m.chat_id,\n  message_thread_id: m.message_thread_id,\n  text: m.text,\n  language_hint: m.language_hint,\n  channel_message_id: m.message_id,\n  update_id: m.update_id,\n  callback_query_id: m.callback_query_id || null,\n};\n\nif (m.has_photo || m.has_voice || !m.text) {\n  return [{ json: { ...base, route: 'placeholder' } }];\n}\nreturn [{ json: { ...base, route: 'agent' } }];"
      },
      "position": [
        1600,
        0
      ],
      "type": "n8n-nodes-base.code",
      "typeVersion": 2
