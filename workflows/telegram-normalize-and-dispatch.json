      "parameters": {
        "jsCode": "const staticData = $getWorkflowStaticData('global');\nif (!staticData.seenUpdateIds) staticData.seenUpdateIds = [];\nconst id = $json.update_id;\nconst already = staticData.seenUpdateIds.includes(id);\nif (!already) {\n  staticData.seenUpdateIds.push(id);\n  if (staticData.seenUpdateIds.length > 5000) {\n    staticData.seenUpdateIds = staticData.seenUpdateIds.slice(-2000);\n  }\n}\nreturn [{ json: { ...$json, duplicate: already } }];"
