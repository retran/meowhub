      "name": "Reply",
      "parameters": {
        "jsonBody": "={{ { chat_id: $('Mint Agent Token').item.json.chat_id, ...($('Mint Agent Token').item.json.message_thread_id ? { message_thread_id: $('Mint Agent Token').item.json.message_thread_id } : {}), text: ($('Mint Agent Token').item.json.language_hint === \"ru\" ? \"Meow на связи. Инфраструктура собрана, продукт ещё впереди.\" : \"Meow is here. The infrastructure works; the product comes next.\") } }}",
        "method": "POST",
