        "jsCode": "const update = $json.update;\nconst msg = update.message || update.edited_message;\nif (!msg) {\n  return [{ json: { skip: true, reason: \"no message in update\" } }];\n}\nreturn [{\n  json: {\n    update_id: update.update_id,\n    channel_id: String(msg.from.id),\n    chat_id: msg.chat.id,\n    message_thread_id: msg.message_thread_id || null,\n    text: msg.text || null,\n    has_photo: !!msg.photo,\n    has_voice: !!msg.voice,\n    language_hint: msg.from.language_code || \"ru\",\n    source: $json.source\n  }\n}];"
      },
