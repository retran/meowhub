        "url": "=https://api.telegram.org/bot{{ $env.TELEGRAM_DELIVERY_MODE === 'polling' ? $env.TELEGRAM_LOCAL_BOT_TOKEN : $env.TELEGRAM_BOT_TOKEN }}/sendMessage"
