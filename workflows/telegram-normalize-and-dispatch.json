    {
      "id": "d0000000-0000-4000-8000-000000000002",
      "name": "Normalize",
      "parameters": {
        "jsCode": "const update = $json.update;\nconst msg = update.message || update.edited_message;\nconst cq = update.callback_query;\nif (!msg && !cq) {\n  return [{ json: { skip: true, reason: \"no message in update\" } }];\n}\nif (cq) {\n  // A tapped inline button (R23) is normalized into the same shape as\n  // a typed message, its callback_data standing in for the text --\n  // Route Message and every downstream workflow never need to know\n  // the difference (A32: tapping approve and typing it are identical\n  // from here on).\n  return [{\n    json: {\n      update_id: update.update_id,\n      message_id: cq.message.message_id,\n      channel_id: String(cq.from.id),\n      chat_id: cq.message.chat.id,\n      message_thread_id: cq.message.message_thread_id || null,\n      text: cq.data || null,\n      has_photo: false,\n      has_voice: false,\n      language_hint: cq.from.language_code || \"ru\",\n      source: $json.source,\n      callback_query_id: cq.id\n    }\n  }];\n}\nreturn [{\n  json: {\n    update_id: update.update_id,\n    message_id: msg.message_id,\n    channel_id: String(msg.from.id),\n    chat_id: msg.chat.id,\n    message_thread_id: msg.message_thread_id || null,\n    text: msg.text || null,\n    has_photo: !!msg.photo,\n    has_voice: !!msg.voice,\n    language_hint: msg.from.language_code || \"ru\",\n    source: $json.source\n  }\n}];"
      },
      "position": [
        280,
        0
      ],
      "type": "n8n-nodes-base.code",
      "typeVersion": 2
    },
